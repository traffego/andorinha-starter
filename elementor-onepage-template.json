              "settings": {
                "html": "<section data-bs-version=\"5.1\" class=\"content4 cid-upL1hJzG36\" id=\"content4-d\">\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"title col-md-12 col-lg-10\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-4 display-2\"><strong>Soluções Criativas para Projetos&nbsp;</strong></h3>\n            </div>\n        </div>\n    </div>\n</section>\n\n<section data-bs-version=\"5.1\" class=\"features5 cid-upL0XG62BF\" id=\"features5-c\">\n    <div class=\"container-fluid\">\n        <div class=\"row\">\n            <div class=\"item features-without-image mb-4 col-12 col-md-4 active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"row\">\n                        <div class=\"col-12 col-md-12\">\n                            <div class=\"text-wrapper\">\n                                <h5 class=\"card-title mbr-fonts-style display-5\" style=\"text-align: center;\"><strong>Para Negócios</strong></h5>\n                                <ul>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Mentorias Direcionadas</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Criação e Gestão de Conteúdos</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Gestão Ágil de Projetos</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Capacitações e Treinamentos</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image mb-4 col-12 col-md-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"row\">\n                        <div class=\"col-12 col-md-12\">\n                            <div class=\"text-wrapper\">\n                                <h5 class=\"card-title mbr-fonts-style display-5\" style=\"text-align: center;\"><strong>Para Projetos</strong></h5>\n                                <ul>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Consultorias Estratégicas</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Gestão de Recursos</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Gestão de Processos</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Elaboração de Projetos e Conteúdos</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Planejamento e Monitoramento de Resultados</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Prestação de Contas e Relatórios de Execução</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Mapeamento Socioterritorial</li>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Assessoria técnica de execução da plataforma transferegov</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image mb-4 col-12 col-md-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"row\">\n                        <div class=\"col-12 col-md-12\">\n                            <div class=\"text-wrapper\">\n                                <h5 class=\"card-title mbr-fonts-style display-5\" style=\"text-align: center;\"><strong>Mecanismos de Financiamento</strong></h5>\n                                <ul>\n                                    <li class=\"mbr-text mbr-fonts-style display-4\" style=\"text-align: justify;\"> Leis de Incentivo ao Editais de Fomento</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>"
