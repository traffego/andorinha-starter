              "id": "f2a3b46",
              "elType": "widget",
              "isInner": false,
              "settings": {
                "html": "<section data-bs-version=\"5.1\" class=\"image2 cid-upKTDVb5F8\" id=\"image2-2\">\n    <div class=\"container\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"image-wrapper\">\n                    <img src=\"assets/images/two-women-work-1256x838.jpg\" alt=\"Andorinha Trabalho em Equipe\">\n                </div>\n            </div>\n            <div class=\"col-12 col-lg\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style display-7\">A Andorinha Negócios Criativos atua no Planejamento das ações e dos resultados na Execução de Projetos Socioeducacionais, culturais, esportivos, de sustentabilidade e empreendedorismo.<br>Somos uma Empresa de Consultoria com foco em Gestão e Gerenciamento de Projeto contemplados em Editais, Leis de Incentivo e Transferências Diretas.<br>Nosso compromisso é com o impacto do resultado das ações pactuadas e para isso, atuamos na gestão dos processos, no monitoramento das ações, com aplicação de diversas ferramentas de avaliação e indicadores de resultados.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>"
              },
              "elements": [],
              "widgetType": "html"
            }
          ]
        }
      ]
    },
