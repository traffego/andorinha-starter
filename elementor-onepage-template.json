              "isInner": false,
              "settings": {
                "html": "<section data-bs-version=\"5.1\" class=\"header19 cid-sFGzrhlvIh mbr-parallax-background\" id=\"header19-3\">\n    <div class=\"mbr-overlay\" style=\"opacity: 0.3; background-color: rgb(2, 8, 115);\"></div>\n    <div class=\"container-fluid\" style=\"margin-top: 150px;\">\n        <div class=\"media-container\" style=\"height: 450px;\">\n            <div class=\"col-md-12 col-lg-10 m-auto align-center\">\n                <h1 class=\"mbr-section-title mbr-white mbr-fonts-style mb-3 display-1\"><strong>Potencializando Impactos Positivos em Projetos e Negócios</strong></h1>\n                <p class=\"mbr-text mbr-white mbr-fonts-style display-7\"><em>A Andorinha Negócios Criativos transforma ideias em resultados, ampliando o alcance e o impacto de iniciativas socioeducacionais, culturais e sustentáveis.</em><br></p>\n                <div class=\"mbr-section-btn align-center\"><a class=\"btn btn-secondary display-4\" href=\"#image2-2\">Leia Mais</a></div>\n            </div>\n        </div>\n    </div>\n</section>"
              },
