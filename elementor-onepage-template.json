              "settings": {
                "html": "<section data-bs-version=\"5.1\" class=\"form3 cid-upL4IZgkut\" id=\"form3-g\">\n    <div class=\"container-fluid\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-lg-7 col-12 \">\n                <div class=\"image-wrapper\" style=\"height: 700px; padding-top: 50px\">\n                    <h1 class=\"mbr-section-title mb-4 display-2\"><strong>Nossa Localização</strong></h1>\n                    <div class=\"google-map\">\n                        <iframe frameborder=\"0\" style=\"border:0; height: 500px; width: 100%;\" src=\"https://www.google.com/maps/embed/v1/place?key=AIzaSyBQ55g-IgRRgXrd803PTWDTb7kd6aAitNQ&amp;q=Av. Embaixador Abelardo Bueno, 3.500 - Sl 318 - Barra da Tijuca, Rio de Janeiro - RJ, 22775-040\" allowfullscreen></iframe>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-lg-3 offset-lg-1 mbr-form\">\n                <form id=\"form\">\n                    <div class=\"row\">\n                        <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\" id=\"msg-success\">Obrigado por preencher o formulário!</div>\n                        <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\" id=\"msg-error\">Oops...! Algo deu errado. Tente novamente mais tarde.</div>\n                    </div>\n                    <div class=\"dragArea row\">\n                        <div class=\"col-lg-12 col-md-12 col-sm-12\">\n                            <h1 class=\"mbr-section-title mb-4 display-2\"><strong>Fale com um Consultor</strong></h1>\n                        </div>\n                        <div data-for=\"nome\" class=\"col-lg-12 col-md col-sm-12 form-group mb-3\">\n                            <input type=\"text\" name=\"nome\" placeholder=\"Nome\" data-form-field=\"nome\" class=\"form-control\" id=\"nome\" required>\n                        </div>\n                        <div class=\"col-lg-12 col-md col-sm-12 form-group mb-3\" data-for=\"email\">\n                            <input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" class=\"form-control\" id=\"email\" required>\n                        </div>\n                        <div class=\"col-lg-12 col-md col-sm-12 form-group mb-3\" data-for=\"phone\">\n                            <input type=\"tel\" name=\"telefone\" placeholder=\"Telefone\" data-form-field=\"telefone\" class=\"form-control\" id=\"telefone\" required>\n                        </div>\n                        <div class=\"col-lg-12 col-md col-sm-12 form-group mb-3\" data-for=\"mensagem\">\n                            <textarea name=\"mensagem\" id=\"mensagem\" placeholder=\"Fale sobre você\" class=\"form-control\" required></textarea>\n                        </div>\n                        <div class=\"col-md-auto col-12 mbr-section-btn\">\n                            <input type=\"submit\" id=\"button\" value=\"Enviar\" class=\"btn btn-black display-4\">\n                        </div>\n                    </div>\n                </form>\n            </div>\n            <div class=\"offset-lg-1\"></div>\n        </div>\n    </div>\n</section>"
