              "id": "c1d2e35",
              "elType": "widget",
              "isInner": false,
              "settings": {
                "html": "<section data-bs-version=\"5.1\" class=\"content10 cid-upKWp2uQT9\" id=\"content10-7\">\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md\">\n                <h5 class=\"mbr-section-title mbr-fonts-style mb-4 display-2\"><strong>Visão</strong></h5>\n            </div>\n            <div class=\"col-md-12 col-lg-6\">\n                <p class=\"mbr-text mbr-fonts-style display-7\">Ser a referência nacional em consultoria para gestão e desenvolvimento de projetos socioeducacionais, culturais, esportivos, de sustentabilidade e empreendedorismo, reconhecida pela excelência, inovação e compromisso com resultados duradouros. Aspiramos a ser um agente transformador, contribuindo para um futuro mais justo, inclusivo e sustentável para todos.</p>\n            </div>\n        </div>\n    </div>\n</section>"
              },
