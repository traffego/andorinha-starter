              "isInner": false,
              "settings": {
                "html": "<section data-bs-version=\"5.1\" class=\"content10 cid-upKW8yw6sP\" id=\"content10-6\">\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md\">\n                <h5 class=\"mbr-section-title mbr-fonts-style mb-4 display-2\"><strong>Missão</strong></h5>\n            </div>\n            <div class=\"col-md-12 col-lg-6\">\n                <p class=\"mbr-text mbr-fonts-style display-7\">Nossa missão é potencializar o impacto positivo de projetos socioeducacionais, culturais, esportivos, de sustentabilidade e empreendedorismo, fornecendo soluções inovadoras e estratégicas de consultoria que promovam o desenvolvimento integral e sustentável dos territórios. Nos dedicamos a transformar ideias em ações concretas, criando parcerias colaborativas e sustentáveis que geram valor para a sociedade e o meio ambiente.</p>\n            </div>\n        </div>\n    </div>\n</section>"
              },
