            {
              "id": "f15a383",
              "elType": "widget",
              "isInner": false,
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>Nossa missão é potencializar o impacto positivo de projetos socioeducacionais, culturais, esportivos, de sustentabilidade e empreendedorismo, fornecendo soluções inovadoras e estratégicas de consultoria que promovam o desenvolvimento integral e sustentável dos territórios. Nos dedicamos a transformar ideias em ações concretas, criando parcerias colaborativas e sustentáveis que geram valor para a sociedade e o meio ambiente.</p>",
                "_css_classes": "mbr-text mbr-fonts-style display-7"
              },
              "elements": []
            }
          ]
